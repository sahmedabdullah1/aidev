# Application
APP_NAME=AI DevOps
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Free open-source LLM (recommended for AI DevOps) ─────────────────────────
# Provider: Groq — free tier, no credit card required
# Model:    Meta Llama 3.3 70B (best quality/speed for SRE RCA on free tier)
# Get key:  https://console.groq.com/keys
#
# 1) Create account at console.groq.com
# 2) Create API key
# 3) Paste it below (either LLM_API_KEY or GROQ_API_KEY)
# 4) Restart uvicorn
LLM_API_KEY=
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=6000
REQUIRE_LLM=true

# Alternatives (still free / open-source):
#   Faster / higher free limits:
#     LLM_MODEL=llama-3.1-8b-instant
#   Larger context on Groq free tier:
#     LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   Fully local (no cloud key) with Ollama:
#     LLM_BASE_URL=http://127.0.0.1:11434/v1
#     LLM_API_KEY=ollama
#     LLM_MODEL=llama3.1

# GitLab automation
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=change-me-to-a-long-random-string
